[Unit]
Description=Xianshushu private browser display
After=network.target

[Service]
User=www-data
Group=www-data
ExecStart=/usr/bin/Xvfb :99 -screen 0 1366x900x24 -nolisten tcp -auth /srv/xianshushu/live-data/Xauthority
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/srv/xianshushu/live-data /tmp

[Install]
WantedBy=multi-user.target
